{
    "extends":  "expo/tsconfig.base",
    "compilerOptions":  {
                            "strict":  true,
                            "noUncheckedIndexedAccess":  true,
                            "exactOptionalPropertyTypes":  true,
                            "noEmit":  true,
                            "types":  [
                                          "jest",
                                          "react",
                                          "react-native"
                                      ]
                        },
    "include":  [
                    "app/**/*.ts",
                    "app/**/*.tsx",
                    "src/**/*.ts",
                    "src/**/*.tsx",
                    ".expo/types/**/*.ts",
                    "expo-env.d.ts"
                ]
}

{
    "name":  "@p1/mobile",
    "version":  "0.1.0",
    "private":  true,
    "main":  "expo-router/entry",
    "scripts":  {
                    "start":  "expo start --dev-client",
                    "android":  "expo run:android",
                    "ios":  "expo run:ios",
                    "lint":  "expo lint",
                    "typecheck":  "tsc --noEmit",
                    "test":  "jest --runInBand",
                    "test:ci":  "jest --runInBand --ci",
                    "doctor":  "expo-doctor",
                    "export":  "expo export --platform android --output-dir dist",
                    "scan:imports":  "node scripts/scan-mobile-imports.mjs",
                    "scan:secrets":  "node scripts/scan-mobile-secrets.mjs",
                    "scan:upload":  "node scripts/scan-eas-manifest.mjs",
                    "preexport":  "npm run scan:imports \u0026\u0026 npm run scan:secrets",
                    "postexport":  "npm run scan:bundle",
                    "scan:bundle":  "node scripts/scan-bundle-secrets.mjs",
                    "eas-build-pre-install":  "npm run scan:imports \u0026\u0026 npm run scan:secrets"
                },
    "dependencies":  {
                         "@p1/design-tokens":  "*",
                         "@p1/mobile-contracts":  "*",
                         "@react-native-async-storage/async-storage":  "2.2.0",
                         "@react-native-community/netinfo":  "12.0.1",
                         "@supabase/supabase-js":  "^2.116.0",
                         "@tanstack/query-async-storage-persister":  "^5.102.8",
                         "@tanstack/react-query":  "^5.102.8",
                         "@tanstack/react-query-persist-client":  "^5.102.8",
                         "expo":  "~57.0.22",
                         "expo-application":  "~57.0.3",
                         "expo-constants":  "~57.0.18",
                         "expo-dev-client":  "~57.0.19",
                         "expo-file-system":  "~57.0.7",
                         "expo-image":  "~57.0.5",
                         "expo-linking":  "~57.0.10",
                         "expo-router":  "~57.0.21",
                         "expo-secure-store":  "~57.0.4",
                         "expo-splash-screen":  "~57.0.9",
                         "expo-status-bar":  "~57.0.1",
                         "expo-system-ui":  "~57.0.4",
                         "react":  "19.2.4",
                         "react-native":  "0.86.3",
                         "react-native-safe-area-context":  "~5.7.0",
                         "react-native-screens":  "~4.26.0",
                         "react-native-url-polyfill":  "^3.0.0"
                     },
    "devDependencies":  {
                            "@testing-library/react-native":  "^14.0.1",
                            "@types/jest":  "29.5.14",
                            "@types/react":  "~19.2.2",
                            "eslint":  "^9.39.2",
                            "eslint-config-expo":  "~57.0.2",
                            "expo-doctor":  "^1.20.4",
                            "jest":  "29.7.0",
                            "jest-expo":  "~57.0.5",
                            "react-test-renderer":  "19.2.4",
                            "typescript":  "~6.0.3"
                        },
    "jest":  {
                 "preset":  "jest-expo",
                 "testPathIgnorePatterns":  [
                                                "/node_modules/",
                                                "/dist/"
                                            ],
                 "collectCoverageFrom":  [
                                             "src/**/*.{ts,tsx}",
                                             "!src/**/*.d.ts"
                                         ],
                 "setupFilesAfterEnv":  [
                                            "\u003crootDir\u003e/jest.setup.ts"
                                        ]
             },
    "expo":  {
                 "install":  {
                                 "exclude":  [
                                                 "react"
                                             ]
                             }
             }
}
